#version 450

layout(std430, binding = 0) readonly buffer Predictions
{
	float predictions[];
};

layout(std430, binding = 1) readonly buffer GroundTruth
{
	float ground_truth[];
};

layout(std430, binding = 2) writeonly buffer Gradient
{
	float gradient[];
};

layout(push_constant) uniform PushConstants
{
	uint n_elements;  // B * H * W  (C is always 1)
} pc;

layout(local_size_x = 256) in;

void main()
{
	uint idx = gl_GlobalInvocationID.x;

	if (idx < pc.n_elements)
	{
		float p = clamp(predictions[idx], 1e-7, 1.0 - 1e-7);
		float y = ground_truth[idx];
		gradient[idx] = (p - y) / float(pc.n_elements);
	}
}