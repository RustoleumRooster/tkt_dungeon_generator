#version 450

// bindings: weights(0), grad_input(1), grad_output(2)

layout(std430, binding = 0) readonly buffer Weights
{
	float weights[];
};

layout(std430, binding = 1) readonly buffer InputGradient
{
	float grad_in[];
};

layout(std430, binding = 2) buffer OutputGradient
{
	float grad_out[];
};

layout(push_constant) uniform PushConstants
{
	uint k;
	uint s;
	uint p;
	uint c_in;
	uint c_out;
	uint img_size_in;
	uint img_size_out;
	uint n;
} pc;

layout(local_size_x = 128) in;

//each thread owns one input position [ih, iw, ic]
//

void main()
{
	uint iw = gl_WorkGroupID.x;
	uint ih = gl_WorkGroupID.y;
	uint N  = gl_WorkGroupID.z;
	uint ic = gl_LocalInvocationID.x;
	uint HW = pc.img_size_in * pc.img_size_in;

	uint OH = pc.img_size_out;
	uint OW = pc.img_size_out;

	if(ic >= pc.c_in)
		return;

	// Iterate over (c_out, kh, kw) and derive (oh, ow) algebraically.
	// oh*s = ih + p - kh  =>  oh = (ih + p - kh) / s  (only if divisible and in bounds)
	// This eliminates 98.5% of wasted iterations vs the old (c_out, oh, ow) loop.

	float x = 0.0;
	for (uint c = 0; c < pc.c_out; c++)
		for (uint kh = 0; kh < pc.k; kh++)
			for (uint kw = 0; kw < pc.k; kw++)
			{
				int oh_num = int(ih) + int(pc.p) - int(kh);
				int ow_num = int(iw) + int(pc.p) - int(kw);

				if (oh_num < 0 || ow_num < 0)                               continue;
				if (oh_num % int(pc.s) != 0 || ow_num % int(pc.s) != 0)    continue;

				uint oh = uint(oh_num) / pc.s;
				uint ow = uint(ow_num) / pc.s;

				if (oh >= OH || ow >= OW) continue;

				x += weights[c * pc.c_in * pc.k * pc.k + ic * pc.k * pc.k + kh * pc.k + kw]
				   * grad_in[N * pc.c_out * OH * OW + c * OH * OW + oh * OW + ow];
			}

	grad_out[N * pc.c_in * HW + ic * HW + ih * pc.img_size_in + iw] = x;
}
