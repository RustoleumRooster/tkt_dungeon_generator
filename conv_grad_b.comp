#version 450

// Dispatch: (c_out, c_in, 1) — one WG per (oc, ic) pair.
// local_size_x = 16 — one thread per kernel position (k² ≤ 16).
//
// Each thread exclusively owns one weight dW[oc, ic, kpos] and accumulates
// it by looping over (batch, oh, ow).  No atomics, no shared memory.
//
// All threads in the WG share the same (oc, ic) and therefore read the same
// grad_in[batch, oc, oh, ow] value each iteration → L1 broadcast, high reuse.

layout(std430, binding = 0) readonly buffer InputTensor   { float input_tensor[]; };
layout(std430, binding = 1) readonly buffer InputGradient { float grad_in[];       };
layout(std430, binding = 2) buffer          WeightGrads   { float grad_weights[];  };

layout(push_constant) uniform PushConstants
{
	uint k;
	uint s;
	uint p;
	uint c_in;
	uint c_out;
	uint img_size_in;
	uint img_size_out;
	uint n;
} pc;

layout(local_size_x = 16) in;   // one thread per kpos; guard handles k² < 16

void main()
{
	uint oc   = gl_WorkGroupID.x;
	uint ic   = gl_WorkGroupID.y;
	uint kpos = gl_LocalInvocationID.x;
	uint kk   = pc.k * pc.k;

	if (kpos >= kk) return;

	uint kh = kpos / pc.k;
	uint kw = kpos % pc.k;

	uint OH = pc.img_size_out;
	uint OW = pc.img_size_out;
	uint IH = pc.img_size_in;
	uint IW = pc.img_size_in;

	float dw = 0.0;

	for (uint batch = 0; batch < pc.n; batch++)
		for (uint oh = 0; oh < OH; oh++)
			for (uint ow = 0; ow < OW; ow++)
			{
				int ih = int(oh * pc.s) - int(pc.p) + int(kh);
				int iw = int(ow * pc.s) - int(pc.p) + int(kw);

				if (ih >= 0 && iw >= 0 && ih < int(IH) && iw < int(IW))
				{
					float g = grad_in[batch * pc.c_out * OH * OW
					                  + oc   * OH * OW
					                  + oh   * OW
					                  + ow];

					float a = input_tensor[batch * pc.c_in * IH * IW
					                       + ic   * IH * IW
					                       + uint(ih) * IW
					                       + uint(iw)];
					dw += g * a;
				}
			}

	// Each thread writes exactly one weight — no atomics needed.
	grad_weights[oc * pc.c_in * kk + ic * kk + kpos] = dw;
}
